# Copie para `.env` e ajuste. Nenhum destes valores tem default seguro em
# produção: com APP_ENV=production a ausência de SECRET_KEY interrompe o boot.

APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=5000

# Assina os tokens JWT e as sessões do Flask. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

DATABASE_URI=sqlite:///tasks.db

# Origens permitidas no CORS, separadas por vírgula. Vazio = CORS desabilitado.
# Nunca use "*" numa API que autentica.
CORS_ORIGINS=http://localhost:3000

# Validade do token de acesso, em minutos
JWT_EXPIRATION_MINUTES=60

# Cria as tabelas ausentes no boot. Mantenha false em produção e use migrations.
BOOTSTRAP_DATABASE=true

# Notificações por e-mail (opcional — sem SMTP_HOST o envio é apenas logado)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT=10
SMTP_USE_TLS=true
