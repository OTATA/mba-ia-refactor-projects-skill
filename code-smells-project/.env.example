# Copie para .env (ou exporte no ambiente) e ajuste conforme o ambiente.
# Nenhum destes valores tem default seguro embutido no código.

# development | production
APP_ENV=development

# Obrigatória quando APP_ENV=production; em development uma chave efêmera é gerada.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Default: false em production, true em development.
APP_DEBUG=

APP_HOST=127.0.0.1
APP_PORT=5000

DATABASE_PATH=loja.db

# Cria as tabelas no boot e insere os dados de exemplo em banco vazio.
# Default: true em development, false em production.
BOOTSTRAP_DATABASE=
SEED_DATABASE=

# Lista de origens permitidas, separadas por vírgula.
# Vazio desabilita CORS (nenhum header é emitido).
CORS_ORIGINS=
