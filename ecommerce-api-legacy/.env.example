# Copie para `.env` e ajuste. `.env` está no .gitignore e não deve ser commitado.
# Rode com: npm run start:env

# development | production
NODE_ENV=development

PORT=3000

# `:memory:` descarta tudo no restart (default). Aponte para um arquivo para persistir.
DATABASE_PATH=:memory:

# Carga de dados de demonstração. Default: ligada fora de produção.
SEED_DATABASE=true

# Loga cada query executada. Default: desligada.
SQL_DEBUG=false

# Chave do gateway de pagamento. OBRIGATÓRIA quando NODE_ENV=production — o boot
# falha sem ela. Fora de produção, um placeholder não-secreto é usado.
#
# A chave `pk_live_...` que estava hardcoded em src/utils.js foi versionada neste
# repositório e precisa ser ROTACIONADA no provedor: remover do código não
# desfaz o vazamento, ela continua no histórico do Git.
PAYMENT_GATEWAY_KEY=pk_test_local_dev_only
